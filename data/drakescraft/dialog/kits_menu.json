{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Kits y Recompensas",
    "bold": true,
    "color": "aqua"
  },
  "body": {
    "type": "minecraft:plain_message",
    "contents": {
      "text": "Kits personales, recompensa diaria y voto. Cada kit valida tu rango y cooldown."
    }
  },
  "actions": [
    {
      "label": {
        "text": "Ver kits disponibles (/kit)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/kit"
      }
    },
    {
      "label": {
        "text": "Reclamar kit inicial (/kit inicial)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/kit inicial"
      }
    },
    {
      "label": {
        "text": "Recompensa Diaria (/daily)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/daily"
      }
    },
    {
      "label": {
        "text": "Enlaces para Votar (/vote)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/vote"
      }
    },
    {
      "label": {
        "text": "Reclamar Llaves de Voto (/claim)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/claim"
      }
    },
    {
      "label": {
        "text": "Volver al Menú Principal"
      },
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "drakescraft:main_menu"
      }
    }
  ]
}
