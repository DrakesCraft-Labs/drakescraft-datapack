{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Proteger tu base",
    "bold": true,
    "color": "green"
  },
  "body": {
    "type": "minecraft:plain_message",
    "width": 360,
    "contents": {
      "text": "Las protecciones se ponen con un bloque. Escribe el nombre del jugador arriba para anadirlo o quitarlo de la tuya."
    }
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "target_player",
      "label": {
        "text": "Jugador:"
      }
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Sacar bloque de proteccion (/ps get)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/ps get"
      }
    },
    {
      "label": {
        "text": "De quien es esto (/ps info)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/ps info"
      }
    },
    {
      "label": {
        "text": "Tus protecciones (/ps list)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/ps list"
      }
    },
    {
      "label": {
        "text": "Cuantas te quedan (/ps count)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/ps count"
      }
    },
    {
      "label": {
        "text": "Ir a tu proteccion (/ps home)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/ps home"
      }
    },
    {
      "label": {
        "text": "Fijar ese punto (/ps sethome)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/ps sethome"
      }
    },
    {
      "label": {
        "text": "Dejar construir a alguien"
      },
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "ps members add $(target_player)"
      }
    },
    {
      "label": {
        "text": "Quitarle el permiso"
      },
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "ps members remove $(target_player)"
      }
    },
    {
      "label": {
        "text": "Darle control total"
      },
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "ps owners add $(target_player)"
      }
    },
    {
      "label": {
        "text": "Unir dos protecciones (/ps merge)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/ps merge"
      }
    },
    {
      "label": {
        "text": "Retirar la proteccion (/ps unclaim)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/ps unclaim"
      }
    },
    {
      "label": {
        "text": "Ver u ocultar el borde (/borde)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/borde"
      }
    },
    {
      "label": {
        "text": "Reglas de dentro (/ps flags)"
      },
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "drakescraft:protection_flags_menu"
      }
    },
    {
      "label": {
        "text": "Volver al menu principal"
      },
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "drakescraft:main_menu"
      }
    }
  ]
}
