{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Beneficios de rango",
    "bold": true,
    "color": "gold"
  },
  "body": {
    "type": "minecraft:plain_message",
    "width": 360,
    "contents": {
      "text": "Herramientas de rango. Solo funcionan si tu rango las incluye; este menu no entrega permisos."
    }
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "new_nickname",
      "label": {
        "text": "Nuevo apodo (/nick):"
      }
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Vuelo personal (/fly)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/fly"
      }
    },
    {
      "label": {
        "text": "Restaurar hambre (/feed)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/feed"
      }
    },
    {
      "label": {
        "text": "Restaurar salud (/heal)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/heal"
      }
    },
    {
      "label": {
        "text": "Reparar lo de la mano (/repair)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/repair"
      }
    },
    {
      "label": {
        "text": "Tus cosmeticos (/cosmeticos)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/cosmeticos"
      }
    },
    {
      "label": {
        "text": "Ponerte algo en la cabeza (/hat)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/hat"
      }
    },
    {
      "label": {
        "text": "Yunque portatil (/anvil)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/anvil"
      }
    },
    {
      "label": {
        "text": "Cofre de ender (/ec)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/ec"
      }
    },
    {
      "label": {
        "text": "Mesa de crafteo (/craft)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/craft"
      }
    },
    {
      "label": {
        "text": "Papelera portatil (/trash)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/trash"
      }
    },
    {
      "label": {
        "text": "Jugadores cercanos (/near)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/near"
      }
    },
    {
      "label": {
        "text": "Hora personal (/ptime)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/ptime day"
      }
    },
    {
      "label": {
        "text": "Clima personal (/pweather)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/pweather sun"
      }
    },
    {
      "label": {
        "text": "Cambiar apodo (/nick)"
      },
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "nick $(new_nickname)"
      }
    },
    {
      "label": {
        "text": "Volver al menu principal"
      },
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "drakescraft:main_menu"
      }
    }
  ]
}
