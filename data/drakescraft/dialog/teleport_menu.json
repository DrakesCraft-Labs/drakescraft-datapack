{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Casas y teletransporte",
    "bold": true,
    "color": "yellow"
  },
  "body": {
    "type": "minecraft:plain_message",
    "width": 360,
    "contents": {
      "text": "Escribe el nombre de la casa o del jugador en los campos de arriba y luego pulsa el boton. Cuantas casas puedes tener depende de tu rango."
    }
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "home_name",
      "label": {
        "text": "Nombre de la casa:"
      }
    },
    {
      "type": "minecraft:text",
      "key": "target_player",
      "label": {
        "text": "Jugador (para TPA):"
      }
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Ir al spawn (/spawn)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/spawn"
      }
    },
    {
      "label": {
        "text": "Volver donde estabas (/back)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/back"
      }
    },
    {
      "label": {
        "text": "Teletransporte aleatorio (/rtp)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/rtp"
      }
    },
    {
      "label": {
        "text": "Ver todas tus casas (/homes)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/homes"
      }
    },
    {
      "label": {
        "text": "Ir a una casa (/home)"
      },
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "home $(home_name)"
      }
    },
    {
      "label": {
        "text": "Guardar esta casa (/sethome)"
      },
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "sethome $(home_name)"
      }
    },
    {
      "label": {
        "text": "Borrar una casa (/delhome)"
      },
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "delhome $(home_name)"
      }
    },
    {
      "label": {
        "text": "Pedir ir a alguien (/tpa)"
      },
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "tpa $(target_player)"
      }
    },
    {
      "label": {
        "text": "Pedir que venga (/tpahere)"
      },
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "tpahere $(target_player)"
      }
    },
    {
      "label": {
        "text": "Aceptar peticion (/tpaccept)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/tpaccept"
      }
    },
    {
      "label": {
        "text": "Rechazar peticion (/tpdeny)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/tpdeny"
      }
    },
    {
      "label": {
        "text": "Volver al menu principal"
      },
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "drakescraft:main_menu"
      }
    }
  ]
}
