{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Utilidades y Herramientas",
    "bold": true,
    "color": "gray"
  },
  "body": {
    "type": "minecraft:plain_message",
    "contents": {
      "text": "Herramientas disponibles para todos. Las utilidades premium estan en Beneficios de rango."
    }
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "msg_player",
      "label": {
        "text": "Jugador para mensaje privado:"
      }
    },
    {
      "type": "minecraft:text",
      "key": "msg_text",
      "label": {
        "text": "Mensaje:"
      }
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Guia para compartir en chat"
      },
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "drakescraft:chat_placeholders_menu"
      }
    },
    {
      "label": {
        "text": "Activar/Desactivar AFK (/afk)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/afk"
      }
    },
    {
      "label": {
        "text": "Ver mi ping (/ping)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/ping"
      }
    },
    {
      "label": {
        "text": "Tiempo jugado (/playtime)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/playtime"
      }
    },
    {
      "label": {
        "text": "Enviar mensaje privado"
      },
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "msg $(msg_player) $(msg_text)"
      }
    },
    {
      "label": {
        "text": "Volver al Menú Principal"
      },
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "drakescraft:main_menu"
      }
    }
  ]
}
